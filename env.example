# =========================
# Database Configuration
# =========================

# MongoDB connection string
# Example:
# mongodb+srv://username:password@cluster0.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/contact
MONGODB_DB=contact

DB_USER=username
DB_PASSWORD=password

# =========================
# Application URLs
# =========================

# NextAuth base URL
NEXTAUTH_URL=http://localhost:3000

# Generate using: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key

# Backend API base URL (safe for browser)
NEXT_PUBLIC_BASE_URL=http://localhost:3500/api

# =========================
# OAuth Providers (Server Only)
# =========================

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# =========================
# Email (SMTP)
# =========================

EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_email_password
EMAIL_FROM="Your App <no-reply@yourapp.com>"

# =========================
# Public App Config
# =========================

NEXT_PUBLIC_CONTAINER=next_personal
NEXT_PUBLIC_TABLE=project
